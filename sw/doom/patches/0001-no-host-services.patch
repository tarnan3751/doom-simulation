Patch 0001: no host services - I_Error only prints and exits (no zenity/system(), no <unistd.h>),
M_MakeDirectory does nothing, and a failed savegame write prints a message instead of I_Error: the SoC
has no OS or storage, and the native reference must behave the same.

diff -ruN a/g_game.c b/g_game.c
--- a/g_game.c	2026-11-06 06:20:38
+++ b/g_game.c	2026-11-06 06:20:39
@@ -17,6 +17,7 @@
 
 
 
+#include <stdio.h>
 #include <string.h>
 #include <stdlib.h>
 #include <math.h>
@@ -1627,13 +1628,11 @@
     {
         // Failed to save the game, so we're going to have to abort. But
         // to be nice, save to somewhere else before we call I_Error().
-        recovery_savegame_file = M_TempFile("recovery.dsg");
-        save_stream = fopen(recovery_savegame_file, "wb");
-        if (save_stream == NULL)
-        {
-            I_Error("Failed to open either '%s' or '%s' to write savegame.",
-                    temp_savegame_file, recovery_savegame_file);
-        }
+        printf("G_DoSaveGame: cannot write '%s', savegame skipped\n",
+               temp_savegame_file);
+        gameaction = ga_nothing;
+        M_StringCopy(savedescription, "", sizeof(savedescription));
+        return;
     }
 
     savegame_error = false;
