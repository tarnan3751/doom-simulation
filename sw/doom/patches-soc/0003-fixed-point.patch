 //
 // FixedDiv, C version.
 //
+// SoC: the same results as upstream's ((int64_t) a << 16) / b, without
+// libgcc's generic 64-bit division (__divdi3, several hundred cycles on
+// RV32IM): once the overflow test has passed, |a| < |b| * 2^14, so the
+// quotient has at most 30 bits and two 32-bit hardware divides give it
+// exactly (udiv_frac).  a == INT_MIN (|a| not representable) keeps the
+// 64-bit expression.
+//
 
+// The remainders below are computed as a - q * b on purpose (a multiply is
+// 2 cycles, a remu 33): the empty asm hides q from GCC, which would otherwise
+// turn the expression back into a remainder instruction.
+#define OPAQUE(v) __asm__ ("" : "+r" (v))
+
+// floor(a * 2^16 / b) for a < b * 2^14 (so the result is below 2^30), b > 0.
+static uint32_t udiv_frac(uint32_t a, uint32_t b)
+{
+    uint32_t q1, r, q0, rhat, bn1, bn0;
+    int s;
+
+    q1 = a / b;                 // integer part, < 2^14
+    OPAQUE(q1);
+    r = a - q1 * b;             // r < b: the fraction is floor(r * 2^16 / b)
+
+    if (b <= 0x10000)
+        return (q1 << 16) + (r << 16) / b;     // r << 16 < 2^32
+
+    // b > 2^16: one step of Knuth's algorithm D in base 2^16 (Hacker's
+    // Delight, divlu).  Normalise b so that its top bit is set; the dividend
+    // (r << s) * 2^16 has the digits (r << s) >> 16, (r << s) & 0xffff, 0.
+    s = 0;
+    if (b <= 0x00ffffff) { s += 8; }
+    if ((b << s) <= 0x0fffffff) { s += 4; }
+    if ((b << s) <= 0x3fffffff) { s += 2; }
+    if ((b << s) <= 0x7fffffff) { s += 1; }
+    b <<= s;
