SoC patch 0002: R_DrawColumn and R_DrawSpan with fewer instructions per pixel - globals read once,
odd pixels first then four per iteration, frac kept << 9 (the texel index is one shift; exact modulo
2^32), destination from viewbase.  The same pixels in the same places.  See sw/doom/README.md.

--- a/r_draw.c	2026-11-06 13:40:48
+++ b/r_draw.c	2026-11-06 13:31:45
@@ -74,7 +74,12 @@
 
 static byte *background_buffer = NULL;
 
+// SoC: ylookup[0] + columnofs[0], set by R_InitBuffer.  Inside the view,
+// ylookup[y] + columnofs[x] == viewbase + y*SCREENWIDTH + x, so the column
+// and span drawers compute their destination without the two tables.
+static byte *viewbase;
 
+
 //
 // R_DrawColumn
 // Source is the top of the column to scale.
@@ -103,8 +108,10 @@
 { 
     int			count; 
     byte*		dest; 
-    fixed_t		frac;
-    fixed_t		fracstep;	 
+    const byte*		source;
+    const lighttable_t*	colormap;
+    unsigned		frac;
+    unsigned		fracstep;
  
     count = dc_yh - dc_yl; 
 
@@ -119,29 +126,47 @@
 	I_Error ("R_DrawColumn: %i to %i at %i", dc_yl, dc_yh, dc_x); 
 #endif 
 
-    // Framebuffer destination address.
-    // Use ylookup LUT to avoid multiply with ScreenWidth.
-    // Use columnofs LUT for subwindows? 
-    dest = ylookup[dc_yl] + columnofs[dc_x];  
+    // SoC: the same pixels as upstream's loop, with fewer instructions.
+    // The globals are read once (a byte store may alias them, so the
+    // compiler would reload them for every pixel), and frac is kept
+    // shifted left by 9: (frac >> FRACBITS) & 127 is bits 16..22 of frac,
+    // i.e. the top 7 bits of frac << 9, and the sums agree modulo 2^32.
+    source = dc_source;
+    colormap = dc_colormap;
+    dest = viewbase + dc_yl*SCREENWIDTH + dc_x;
+    fracstep = (unsigned) dc_iscale << 9;
+    frac = (unsigned) (dc_texturemid + (dc_yl-centery)*dc_iscale) << 9;
+    count++;
 
-    // Determine scaling,
-    //  which is the only mapping to be done.
-    fracstep = dc_iscale; 
-    frac = dc_texturemid + (dc_yl-centery)*fracstep; 
-
-    // Inner loop that does the actual texture mapping,
-    //  e.g. a DDA-lile scaling.
-    // This is as fast as it gets.
-    do 
+    // the odd pixels first, then groups of four
+    if (count & 1)
     {
-	// Re-map color indices from wall texture column
-	//  using a lighting/special effects LUT.
-	*dest = dc_colormap[dc_source[(frac>>FRACBITS)&127]];
-	
-	dest += SCREENWIDTH; 
+	*dest = colormap[source[frac >> 25]];
+	dest += SCREENWIDTH;
 	frac += fracstep;
-	
-    } while (count--); 
+    }
+    if (count & 2)
+    {
+	dest[0] = colormap[source[frac >> 25]];
+	frac += fracstep;
+	dest[SCREENWIDTH] = colormap[source[frac >> 25]];
+	frac += fracstep;
+	dest += 2*SCREENWIDTH;
+    }
+    for (count >>= 2; count > 0; count--)
+    {
+	byte a, b, c, d;
+
+	a = source[frac >> 25]; frac += fracstep;
+	b = source[frac >> 25]; frac += fracstep;
+	c = source[frac >> 25]; frac += fracstep;
+	d = source[frac >> 25]; frac += fracstep;
+	dest[0] = colormap[a];
+	dest[SCREENWIDTH] = colormap[b];
+	dest[2*SCREENWIDTH] = colormap[c];
+	dest[3*SCREENWIDTH] = colormap[d];
+	dest += 4*SCREENWIDTH;
+    }
 } 
 
 
